# Local/mock runs only. In the cloud, credentials are network secrets injected by the proxy
# and never appear in this repo or in environment variables.
COACH_MOCK=1
# Optional overrides
# COACH_HOME=/path/to/repo            # repo root holding config/ and state/
# COACH_STATE_DIR=/tmp/coach-state    # write state somewhere else (simulate does this automatically)
# COACH_TODAY=2026-11-16              # pretend today is this date (America/New_York)
# Names used in Phase 2 (documented here, values live in the cloud environment):
# HEVY_API_KEY, INTERVALS_API_KEY, INTERVALS_ATHLETE_ID, WHOOP_BROKER_URL, WHOOP_BROKER_KEY,
# WITHINGS_BROKER_URL (same broker), NCBI_EMAIL (optional, for E-utilities politeness)
